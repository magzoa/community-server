# ============================================================================
#  Variables de entorno del Stack de producción (Portainer)
#  Copia estos valores en la sección "Environment variables" del Stack, o
#  sube este archivo como .env. NO subas secretos reales al repositorio.
# ============================================================================

# Genera una con: php artisan key:generate --show   (o docker run ... artisan key:generate)
APP_KEY=base64:CAMBIA_ESTA_CLAVE

APP_NAME="AWS UG CAN"

# URL pública de la EC2 (usa tu IP o dominio). Importante para storage:link y avatares.
APP_URL=http://18.231.63.186

# --- Base de datos MariaDB --------------------------------------------------
DB_DATABASE=community_aws
DB_USERNAME=community
DB_PASSWORD=community
DB_ROOT_PASSWORD=rootsecret

# --- Despliegue -------------------------------------------------------------
# Ponlo en true SOLO para el primer despliegue (crea roles + admin + catálogos).
# Después cámbialo a false y vuelve a desplegar para no re-sembrar.
SEED_ON_DEPLOY=true
